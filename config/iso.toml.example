# config/iso.toml.example — bootc-image-builder ISO customizations.
#
# Copy to config/iso.toml (gitignored — it holds a password) and edit.
# Without a config/iso.toml the installed system has NO user accounts at all:
# the generic bootc base images ship none, and the unattended Anaconda ISO
# creates none, so nobody can log in.
#
# Full option reference: https://osbuild.org/docs/user-guide/blueprint-reference
# (not all blueprint options are supported by bootc-image-builder).

# Do NOT ship ISOs built with a shared/known password — the unattended
# installer puts this login on every machine the ISO boots on. The password
# set here is only the initial one; `passwd` after install persists normally.
# The SSH key is strongly recommended: a typo'd password can't lock you out.
[[customizations.user]]
name = "carino"
password = "changeme"
# key = "ssh-ed25519 AAAA... you@host"    # from ~/.ssh/id_ed25519.pub
groups = ["wheel"]                        # sudo
