[Unit]
Description=carino-offline first-boot integration (firewall, trust store)
Documentation=file:///usr/libexec/carino-offline-firstboot
# firewalld only: the script talks to firewalld over D-Bus and rewrites the
# local CA trust bundles, neither of which touches the network. Pulling in
# network-online.target would park NetworkManager-wait-online (60 s default) on
# the boot path of the one image built on the premise that the WAN is down.
Wants=firewalld.service
After=firewalld.service
# Run once per installed system; the script writes the stamp on success, so a
# failed run is retried on the next boot rather than being silently lost.
ConditionPathExists=!/var/lib/fedora-images/.carino-offline-done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/carino-offline-firstboot

[Install]
WantedBy=multi-user.target
