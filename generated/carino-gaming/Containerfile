FROM localhost/carino-layer-de-cosmic-hyprland:latest

LABEL org.opencontainers.image.title="carino-gaming" \
      org.opencontainers.image.description="Gaming: gamescope, mangohud, gamemode, wine, input tooling" \
      org.opencontainers.image.base.name="quay.io/fedora/fedora-bootc:44"

# Packages
RUN dnf -y install steam-devices lutris gamescope mangohud gamemode wine winetricks antimicrox solaar libratbag-ratbagd nvtop radeontop vulkan-tools mpv htop fastfetch && dnf clean all

# Services (enable)
RUN systemctl enable ratbagd.service

# Kernel arguments (slot 40)
RUN mkdir -p /usr/lib/bootc/kargs.d && \
    echo 'kargs = ["split_lock_detect=off"]' > /usr/lib/bootc/kargs.d/40-gaming.toml

# Flatpak list (installed on first boot by flatpak-setup.service)
RUN mkdir -p /usr/share/fedora-images/flatpaks.d && \
    printf '%s\n' net.davidotek.pupgui2 com.heroicgameslauncher.hgl com.valvesoftware.Steam net.pcsx2.PCSX2 net.rpcs3.RPCS3 org.duckstation.DuckStation org.ppsspp.PPSSPP net.kuribo64.melonDS io.github.azahar_emu.Azahar app.xemu.xemu org.flycast.Flycast info.cemu.Cemu > /usr/share/fedora-images/flatpaks.d/40-gaming.list

# Lint the resulting bootc image
RUN bootc container lint
