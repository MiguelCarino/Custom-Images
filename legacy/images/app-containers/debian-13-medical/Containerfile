# =============================================================================
# App container: Debian 13 (Trixie) — Medical imaging environment
# =============================================================================
# Distrobox guest container running on a Fedora bootc host.
# GUI apps appear on the host desktop via Distrobox integration.
# =============================================================================

FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# Enable non-free + contrib repos
# ---------------------------------------------------------------------------
RUN apt-get update \
    && apt-get install -y software-properties-common \
    && echo "deb http://deb.debian.org/debian trixie contrib non-free non-free-firmware" \
         >> /etc/apt/sources.list.d/non-free.list \
    && apt-get update

# ---------------------------------------------------------------------------
# Medical imaging packages
# ---------------------------------------------------------------------------
RUN apt-get install -y \
      dcmtk \
      gdcm-tools \
      python3-gdcm \
      python3-pydicom \
      geeqie \
      inkscape \
      libreoffice \
      libreoffice-writer \
      libreoffice-calc \
      libreoffice-impress \
      libreoffice-draw \
      python3-pip \
      python3-numpy \
      python3-matplotlib \
      gnuplot \
      openjdk-21-jre-headless \
      age \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Weasis DICOM viewer
# ---------------------------------------------------------------------------
ARG WEASIS_VERSION=4.3.0
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL -o /tmp/weasis.deb \
      "https://github.com/nroduit/Weasis/releases/download/v${WEASIS_VERSION}/weasis_${WEASIS_VERSION}-1_amd64.deb" \
    && dpkg -i /tmp/weasis.deb || apt-get install -fy \
    && rm -f /tmp/weasis.deb \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Python extras
# ---------------------------------------------------------------------------
RUN pip3 install --no-cache-dir itk SimpleITK nibabel pynetdicom

# ---------------------------------------------------------------------------
# Distrobox integration tools
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y \
      sudo \
      bash-completion \
      curl \
      wget \
      git \
      vim \
      xdg-utils \
      locales \
    && echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen && locale-gen \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
